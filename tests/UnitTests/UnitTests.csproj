<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GooglePhotoWallpaper.Tests</RootNamespace>
    <AssemblyName>UnitTests</AssemblyName>
  </PropertyGroup>

  <!--
    Both units under test are pure logic with no Windows dependencies, so they compile straight into
    this plain console runner. That keeps the tests runnable with nothing but the .NET SDK - no NuGet
    feed, no test framework to restore.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\GooglePhotoWallpaper\Services\RotationEngine.cs"
             Link="RotationEngine.cs" />
    <Compile Include="..\..\src\GooglePhotoWallpaper\Services\Sources\SharedAlbumParser.cs"
             Link="SharedAlbumParser.cs" />
    <Compile Include="..\..\src\GooglePhotoWallpaper\Services\FitGeometry.cs"
             Link="FitGeometry.cs" />
  </ItemGroup>

</Project>
