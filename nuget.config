<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pinned so a clone builds the same way on any machine, including ones with no global NuGet
    source configured. The app itself has no package dependencies; this feed is only needed to
    fetch the .NET runtime packs for a self-contained publish.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
