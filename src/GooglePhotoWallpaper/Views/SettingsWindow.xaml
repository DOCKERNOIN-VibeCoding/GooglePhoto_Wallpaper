<Window x:Class="GooglePhotoWallpaper.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Google Photo Wallpaper 설정"
        Width="620" Height="760"
        MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Google Photo Wallpaper" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusLine" Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Text="상태를 불러오는 중..." />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>

                <!-- Current assignment preview -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="현재 화면 배치" Style="{StaticResource SectionTitle}" />
                        <ItemsControl x:Name="MonitorPreview">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,10,0">
                                        <Border CornerRadius="5" BorderBrush="{StaticResource Line}"
                                                BorderThickness="1" Background="#EEF0F2"
                                                Height="86" ClipToBounds="True">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   FontSize="12" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding Caption}" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="PreviewHint" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Photo source -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="사진 가져올 곳" Style="{StaticResource SectionTitle}" />

                        <RadioButton x:Name="SourceAlbumRadio" GroupName="Source"
                                     Content="Google Photos 공유 앨범 (자동 동기화)"
                                     Checked="OnSourceChanged" />
                        <StackPanel Margin="22,2,0,10"
                                    Visibility="{Binding IsChecked, ElementName=SourceAlbumRadio,
                                                 Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Google Photos에서 앨범을 열고 공유 → 링크 만들기로 받은 주소를 붙여넣으세요. 이후 그 앨범에 사진을 추가하기만 하면 자동으로 배경화면 목록에 들어옵니다. 로그인도 Google Cloud 설정도 필요 없습니다." />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AlbumUrlBox" Grid.Column="0"
                                         ToolTip="https://photos.app.goo.gl/... 또는 https://photos.google.com/share/..." />
                                <Button Grid.Column="1" Content="지금 동기화" Margin="6,0,0,0"
                                        Click="OnSyncAlbum" />
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="확인 주기" VerticalAlignment="Center"
                                           FontSize="12.5" Margin="0,0,10,0" />
                                <ComboBox x:Name="AlbumSyncCombo" Grid.Column="1" Width="110"
                                          IsEditable="True"
                                          SelectionChanged="OnAlbumSyncIntervalChanged"
                                          LostFocus="OnAlbumSyncIntervalChanged" />
                                <TextBlock x:Name="AlbumTrafficHint" Grid.Column="2"
                                           Style="{StaticResource Hint}" VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </Grid>

                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="공유 페이지를 직접 읽는 비공식 방식입니다. Google이 페이지 구조를 바꾸면 동작하지 않을 수 있고, 그때는 아래 '로컬 폴더'로 전환하면 됩니다." />
                        </StackPanel>

                        <RadioButton x:Name="SourceFolderRadio" GroupName="Source"
                                     Content="로컬 폴더" Checked="OnSourceChanged" />
                        <StackPanel Margin="22,2,0,0"
                                    Visibility="{Binding IsChecked, ElementName=SourceFolderRadio,
                                                 Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="폴더에 파일이 추가되면 다음 변경 때 자동으로 반영됩니다. Google Takeout으로 내려받은 앨범 폴더나 동기화 폴더를 지정하세요." />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FolderPathBox" Grid.Column="0" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="찾아보기" Margin="6,0,0,0"
                                        Click="OnBrowseFolder" />
                            </Grid>
                            <CheckBox x:Name="RecursiveCheck" Content="하위 폴더까지 포함" />
                            <Button Content="지금 다시 읽기" HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Click="OnRescanFolder" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Rotation -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="바꾸는 방식" Style="{StaticResource SectionTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="변경 주기" VerticalAlignment="Center"
                                       FontSize="12.5" Margin="0,0,10,0" />
                            <ComboBox x:Name="IntervalCombo" Grid.Column="1" Width="130" IsEditable="True" />
                            <TextBlock Grid.Column="2" Text="분" VerticalAlignment="Center"
                                       FontSize="12.5" Margin="8,0,0,0" />
                        </Grid>

                        <Separator Margin="0,14,0,10" Background="{StaticResource Line}" />

                        <TextBlock Text="여러 모니터를 쓸 때" FontSize="12.5" FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <RadioButton x:Name="SequentialRadio" GroupName="MonitorMode"
                                     Content="모니터마다 다음 사진을 이어서 보여주기" />
                        <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,6"
                                   Text="모니터1=A·모니터2=B → 모니터1=B·모니터2=C → 모니터1=C·모니터2=D 순으로 한 칸씩 밀립니다." />
                        <RadioButton x:Name="MirrorRadio" GroupName="MonitorMode"
                                     Content="모든 모니터에 같은 사진 보여주기" />
                        <RadioButton x:Name="SingleRadio" GroupName="MonitorMode"
                                     Content="지정한 모니터 한 대만 바꾸기" />
                        <StackPanel Margin="22,2,0,0"
                                    Visibility="{Binding IsChecked, ElementName=SingleRadio,
                                                 Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="나머지 모니터는 지금 배경화면을 그대로 둡니다. 이 프로그램이 설정하지 않은 배경화면도 건드리지 않습니다." />
                            <ComboBox x:Name="TargetMonitorCombo" Width="220" Margin="0,6,0,0"
                                      HorizontalAlignment="Left" />
                        </StackPanel>

                        <Separator Margin="0,14,0,10" Background="{StaticResource Line}" />

                        <CheckBox x:Name="ShuffleCheck" Content="사진 순서 섞기" />
                        <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,10"
                                   Text="섞어도 모니터끼리 한 칸씩 이어지는 관계는 그대로 유지됩니다." />

                        <TextBlock Text="사진이 화면 비율과 다를 때" FontSize="12.5" FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <ComboBox x:Name="FitCombo" Width="260" HorizontalAlignment="Left"
                                  SelectionChanged="OnFitModeChanged" />
                        <TextBlock x:Name="FitHint" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Misc -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="기타" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="StartupCheck" Content="Windows 시작할 때 자동 실행" />
                        <CheckBox x:Name="ChangeOnStartCheck" Content="프로그램을 켤 때 바로 한 장 넘기기" />
                        <Button Content="캐시 폴더 열기" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Click="OnOpenCacheFolder" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BusyLine" Grid.Column="0" Style="{StaticResource Hint}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="지금 다음 사진" Click="OnAdvanceNow" />
                    <Button Content="저장" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                            Click="OnSave" />
                    <Button Content="닫기" Margin="8,0,0,0" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
